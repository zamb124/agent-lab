# GPU/ML image для provider-litserve (и других сервисов, требующих GIL-build
# torchaudio / pyannote / silero). FROM agent-lab-base-gpu (Python 3.14 GIL).
#
# Главный платформенный образ платформы (ghcr.io/zamb124/agent-lab) — на 3.14t
# free-threaded. Этот GPU-образ существует ТОЛЬКО потому, что torchaudio пока
# не публикует cp314t wheels (PEP 703 stable-ABI). После того как pytorch/audio
# выпустят cp314t wheels — этот файл и базу можно удалить, вернув provider-litserve
# на общий image.

ARG BASE_GPU_IMAGE=ghcr.io/zamb124/agent-lab-base-gpu:latest

# UI собирается так же, как в основном Dockerfile: браузер получает только ui-dist и embed-dist.
FROM node:26-bookworm-slim AS ui-builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.base.json ./
COPY scripts/build/ui.ts ./scripts/build/ui.ts
COPY core/frontend/static ./core/frontend/static
COPY tests/ui/design-system/components ./tests/ui/design-system/components
COPY apps/ ./apps/
RUN npm run typecheck:ui \
    && npm run build:ui \
    && for d in apps/*/ui-dist; do mkdir -p "/out/$d" && cp -a "$d/." "/out/$d/"; done \
    && mkdir -p /out/core/frontend && cp -a core/frontend/embed-dist /out/core/frontend/embed-dist

FROM ${BASE_GPU_IMAGE} AS base-with-core

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

# Базовый image иногда оставляет torchvision 0.28+ при torch 2.12 →
# RuntimeError: operator torchvision::nms does not exist.
# --no-deps: uv resolver иначе требует torch==2.12.1 для torchvision==0.27.1.
RUN uv pip install --python /opt/venv/bin/python --force-reinstall --no-deps \
        "torchvision==0.27.1"

COPY core/ ./core/
COPY apps/ ./apps/
COPY --from=ui-builder /out/apps/ ./apps/
COPY --from=ui-builder /out/core/frontend/embed-dist ./core/frontend/embed-dist
COPY scripts/ ./scripts/
COPY migrations/ ./migrations/

EXPOSE 8014
CMD ["granian", "--interface", "asgi", "apps.provider_litserve.main:app", "--host", "0.0.0.0", "--port", "8014", "--http", "auto", "--ws"]
