{
 "schemaVersion": 39,
 "id": null,
 "uid": "platform-economics",
 "title": "Platform Economics",
 "tags": [
  "billing",
  "economics",
  "product"
 ],
 "timezone": "utc",
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "type": "query",
    "query": "label_values(service)",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "llm_provider",
    "type": "query",
    "query": "label_values({service=~\"$service\"} | json | message=\"llm_stream_response\", llm_provider)",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "llm_model",
    "type": "query",
    "query": "label_values({service=~\"$service\"} | json | message=\"llm_stream_response\" | llm_provider=~\"$llm_provider\", llm_model)",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Billing Settlement Lag P99",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"billing_settlement_lag\" | unwrap platform_billing_settlement_lag_ms [5m]) by (operation_name)",
     "legendFormat": "{{operation_name}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 2,
   "title": "Billing Settlement Backlog (events/min)",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (service) (rate({service=~\"$service\"} | json | message=\"billing_settlement_lag\" [5m])) * 60",
     "legendFormat": "{{service}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 3,
   "title": "Output Tokens/min by Provider/Model",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (llm_provider, llm_model) (rate({service=~\"$service\"} | json | message=\"llm_stream_response\" | llm_provider=~\"$llm_provider\" | llm_model=~\"$llm_model\" | unwrap llm_tokens_output [2m])) * 60",
     "legendFormat": "{{llm_provider}} / {{llm_model}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 4,
   "title": "Platform Events / min by type",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "description": "Пульс продукта: события шины по типу (заказы, сообщения, flow, CRM). Эмиттер realtime ingest — загорается после деплоя.",
   "targets": [
    {
     "expr": "sum by (platform_event_type) (rate({service=~\"$service\"} | json | message=\"platform_event_published\" [15m])) * 60",
     "legendFormat": "{{platform_event_type}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Settled Spans / min",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "description": "Пропускная способность биллинг-пайплайна: списаний spans в минуту.",
   "targets": [
    {
     "expr": "sum(rate({service=~\"$service\"} | json | message=\"idle.span_billing_settlement_tick\" | unwrap settled [15m])) * 60",
     "legendFormat": "settled",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Settlement Errors / min",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "description": "Ошибки списания — деньги не доходят до UsageRecord. Должно быть 0.",
   "targets": [
    {
     "expr": "sum(rate({service=~\"$service\"} | json | message=\"idle.span_billing_settlement_tick\" | unwrap errors [15m])) * 60",
     "legendFormat": "errors",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "title": "Company Balance (RUB)",
   "type": "table",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 27
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "topk(25, max by (company_id) (last_over_time({service=~\"$service\"} | json | message=\"billing.event\" | unwrap balance [30m])))",
     "refId": "A",
     "queryType": "instant",
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "company_id": "Company",
       "Value": "Balance RUB"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red"
       },
       {
        "color": "green",
        "value": 0
       }
      ]
     }
    }
   }
  },
  {
   "title": "Month Spend by Company (RUB)",
   "type": "table",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 27
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "topk(25, max by (company_id) (last_over_time({service=~\"$service\"} | json | message=\"billing.event\" | unwrap current_month_spent [30m])))",
     "refId": "A",
     "queryType": "instant",
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "company_id": "Company",
       "Value": "Spent RUB"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   }
  },
  {
   "title": "Billing Events / min (spend throughput)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 27
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (company_id) (rate({service=~\"$service\"} | json | message=\"billing.event\" [5m])) * 60",
     "legendFormat": "{{company_id}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   }
  }
 ]
}