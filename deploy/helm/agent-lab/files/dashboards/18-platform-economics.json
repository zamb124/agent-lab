{
  "schemaVersion": 39,
  "id": null,
  "uid": "platform-economics",
  "title": "Platform Economics",
  "tags": ["billing", "economics", "product"],
  "timezone": "utc",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(service)",
        "datasource": {"type": "loki", "uid": "loki"},
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "llm_provider",
        "type": "query",
        "query": "label_values({service=~\"$service\"} | json | message=\"llm_stream_response\", llm_provider)",
        "datasource": {"type": "loki", "uid": "loki"},
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "llm_model",
        "type": "query",
        "query": "label_values({service=~\"$service\"} | json | message=\"llm_stream_response\" | llm_provider=~\"$llm_provider\", llm_model)",
        "datasource": {"type": "loki", "uid": "loki"},
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Billing Settlement Lag P99",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"billing_settlement_lag\" | unwrap platform_billing_settlement_lag_ms [5m]) by (operation_name)",
          "legendFormat": "{{operation_name}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 2,
      "title": "Billing Settlement Backlog (events/min)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (service) (rate({service=~\"$service\"} | json | message=\"billing_settlement_lag\" [5m])) * 60",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 3,
      "title": "Output Tokens/min by Provider/Model",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 6},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (llm_provider, llm_model) (rate({service=~\"$service\"} | json | message=\"llm_stream_response\" | llm_provider=~\"$llm_provider\" | llm_model=~\"$llm_model\" | unwrap llm_tokens_output [2m])) * 60",
          "legendFormat": "{{llm_provider}} / {{llm_model}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    }
  ]
}
