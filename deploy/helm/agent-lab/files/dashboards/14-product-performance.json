   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (llm_provider, llm_model) (rate({service=~\"$service\"} | json | message=\"llm_stream_response\" | unwrap llm_tokens_output [$__interval]))",
     "legendFormat": "{{llm_provider}} / {{llm_model}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "tps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   },
   "interval": "5m"
  },
