   "targets": [
    {
     "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"llm_stream_response\" | unwrap llm_ttft_ms [$__interval]) by (llm_provider, llm_model)",
     "legendFormat": "{{llm_provider}} / {{llm_model}}",
     "refId": "A",
     "queryType": "range"
