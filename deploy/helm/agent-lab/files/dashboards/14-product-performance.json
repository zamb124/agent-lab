{
 "schemaVersion": 39,
 "id": null,
 "uid": "product-performance",
 "title": "Product Performance",
 "tags": [
  "product",
  "sli",
  "latency"
 ],
 "timezone": "utc",
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "type": "query",
    "query": "label_values(service)",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Flow Task Pickup P99",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"task_started\" | task_name=\"process_flow_task\" | unwrap task_queue_wait_ms [$__interval]) by (service)",
     "legendFormat": "{{service}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   },
   "interval": "5m"
  },
  {
   "id": 2,
   "title": "Flow First Content Chunk P99",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"flow_first_content_chunk\" | unwrap flow_first_content_chunk_ms [$__interval]) by (service)",
     "legendFormat": "{{service}}",
     "refId": "A",
