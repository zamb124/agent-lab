{"schemaVersion": 39, "id": null, "uid": "taskiq-workers", "title": "TaskIQ Workers", "tags": ["taskiq", "workers", "tasks"], "timezone": "utc", "refresh": "30s", "time": {"from": "now-1h", "to": "now"}, "templating": {"list": [{"name": "service", "type": "query", "query": "label_values(service)", "datasource": {"type": "loki", "uid": "loki"}, "multi": true, "includeAll": true, "allValue": ".+", "current": {"text": ["All"], "value": ["$__all"]}}]}, "panels": [{"id": 1, "title": "Tasks / min by Worker", "type": "timeseries", "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "sum by (service) (rate({service=~\"$service\"} | json | message=\"task_started\" [$__interval])) * 60", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}, {"id": 2, "title": "Task Failure Rate", "type": "timeseries", "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "sum by (service) (rate({service=~\"$service\"} | json | message=\"task_failed\" [$__interval])) / sum by (service) (rate({service=~\"$service\"} | json | message=\"task_started\" [$__interval])) * 100", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}, {"id": 3, "title": "Avg Task Duration", "type": "timeseries", "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "avg by (service) (sum_over_time({service=~\"$service\"} | json | message=\"task_finished\" | unwrap task_duration_ms [$__interval])) / avg by (service) (count_over_time({service=~\"$service\"} | json | message=\"task_finished\" [$__interval]))", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}, {"id": 4, "title": "Retries", "type": "timeseries", "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "sum by (service) (rate({service=~\"$service\"} | json | task_retry > 0 [$__interval]))", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}, {"id": 5, "title": "Top Failing Task Names", "type": "table", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "topk(10, sum by (task_name) (rate({service=~\"$service\"} | json | message=\"task_failed\" [$__range])))", "legendFormat": "{{task_name}}", "refId": "A", "instant": true, "queryType": "range"}], "transformations": [{"id": "labelsToFields", "options": {}}, {"id": "organize", "options": {"indexByName": {"task_name": 0, "Value": 1}, "renameByName": {"Value": "Failures", "task_name": "Task"}}}]}, {"id": 6, "title": "Recent Failed Tasks", "type": "logs", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{service=~\"$service\"} | json | message=\"task_failed\"", "refId": "A", "queryType": "logs"}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}}, {"id": 7, "title": "Queue Wait P99", "type": "timeseries", "gridPos": {"h": 6, "w": 12, "x": 0, "y": 30}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"task_started\" | unwrap task_queue_wait_ms [$__interval]) by (service)", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}, {"id": 8, "title": "Session Lock Wait P99", "type": "timeseries", "gridPos": {"h": 6, "w": 12, "x": 12, "y": 30}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"task_started\" | unwrap task_lock_wait_ms [$__interval]) by (service)", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}, {"id": 9, "title": "Flow Task Pickup P99", "type": "timeseries", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 36}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"task_started\" | task_name=\"process_flow_task\" | unwrap task_queue_wait_ms [$__interval]) by (service)", "legendFormat": "{{service}}", "refId": "A", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "interval": "5m"}]}