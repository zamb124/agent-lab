  {
   "id": 15,
   "title": "Снапшоты и индексация",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 16,
   "title": "Снапшоты: отдача по источнику / мин",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 34
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (source) (rate({service=\"frontend\",log_type=\"seo\"} | json | message=~\"seo.snapshot.*\" | message=\"seo.snapshot.served\" [$__interval])) * 60",
     "legendFormat": "{{source}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "interval": "5m"
  },
