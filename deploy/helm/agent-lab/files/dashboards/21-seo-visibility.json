{
 "schemaVersion": 39,
 "uid": "seo-visibility",
 "title": "SEO Visibility",
 "tags": [
  "seo",
  "visitors",
  "indexing",
  "linnex"
 ],
 "timezone": "utc",
 "refresh": "5m",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "id": 1,
   "title": "Посетители",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "title": "Уникальные посетители (период)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum(count by (visitor) (count_over_time({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" | bot=\"false\" | visitor!=\"\" [$__range])))",
     "refId": "A",
     "instant": true,
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   }
  },
  {
   "id": 3,
   "title": "Визиты людей (период)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" | bot=\"false\" [$__range]))",
     "refId": "A",
     "instant": true,
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   }
  },
  {
   "id": 4,
   "title": "Запросы ботов (период)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 1
