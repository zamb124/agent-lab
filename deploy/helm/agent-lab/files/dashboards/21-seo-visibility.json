     "instant": true,
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   }
  },
  {
   "id": 6,
   "title": "Визиты по поверхности / мин",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (surface) (rate({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" [$__interval])) * 60",
     "legendFormat": "{{surface}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "interval": "5m"
  },
  {
   "id": 7,
   "title": "Люди vs боты / мин",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (bot) (rate({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" [$__interval])) * 60",
     "legendFormat": "bot={{bot}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "interval": "5m"
  },
  {
   "id": 8,
   "title": "Топ стран (люди)",
   "type": "table",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 11
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "topk(20, sum by (country) (count_over_time({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" | bot=\"false\" | country!=\"\" [$__range])))",
     "refId": "A",
     "instant": true,
     "queryType": "range"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "Value": "Count"
      }
     }
    }
   ]
  },
  {
