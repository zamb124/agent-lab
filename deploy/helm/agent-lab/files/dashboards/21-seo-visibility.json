   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" | bot=\"true\" [$__range]))",
     "refId": "A",
     "instant": true,
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   }
  },
  {
   "id": 5,
   "title": "Стран покрыто",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum(count by (country) (count_over_time({service=\"frontend\",log_type=\"seo\"} | json | message=\"seo.visit\" | bot=\"false\" | country!=\"\" [$__range])))",
