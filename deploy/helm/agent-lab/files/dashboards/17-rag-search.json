{
  "schemaVersion": 39,
  "id": null,
  "uid": "rag-search",
  "title": "RAG Search",
  "tags": ["rag", "search", "product"],
  "timezone": "utc",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(service)",
        "datasource": {"type": "loki", "uid": "loki"},
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "RAG Index E2E P99",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"operation_finished\" | operation_name=\"rag.worker.index.upload_s3\" | unwrap operation_duration_ms [5m]) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 2,
      "title": "Embedding Batch P99",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"operation_finished\" | operation_name=\"rag.embed.batch\" | unwrap operation_duration_ms [5m]) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 3,
      "title": "RAG Search Latency P99",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"operation_finished\" | operation_name=\"rag.search.namespace\" | unwrap operation_duration_ms [5m]) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 4,
      "title": "Rerank Latency P99",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {service=~\"$service\"} | json | message=\"operation_finished\" | operation_name=\"rag.rerank.after_retrieve\" | unwrap operation_duration_ms [5m]) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    }
  ]
}
