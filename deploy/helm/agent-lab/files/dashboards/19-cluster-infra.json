{
  "schemaVersion": 39,
  "id": null,
  "uid": "cluster-infra",
  "title": "Cluster Infrastructure",
  "tags": ["infrastructure", "prometheus", "kubernetes", "resources"],
  "timezone": "utc",
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(granian_requests_handled, service)",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {"text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape Targets Up",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(up) / count(up) * 100", "legendFormat": "up %", "refId": "A", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 95}]}}}
    },
    {
      "id": 2,
      "title": "Pods Not Running",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "count(kube_pod_status_phase{namespace=\"platform\", phase=~\"Failed|Pending|Unknown\"} == 1)", "refId": "A", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 3,
      "title": "Container Restarts (1h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"platform\"}[1h]))", "refId": "A", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 4,
      "title": "Node Disk Free (root)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"}", "refId": "A", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 10}, {"color": "green", "value": 20}]}}}
    },
    {
      "id": 5,
      "title": "Pod CPU (cores) by Service",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"platform\", container!=\"\", container!=\"POD\"}[5m]))", "legendFormat": "{{container}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 6,
      "title": "Pod Memory (working set) by Service",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"platform\", container!=\"\", container!=\"POD\"})", "legendFormat": "{{container}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 7,
      "title": "Restarts by Pod (1h)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 11},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"platform\"}[1h]))", "legendFormat": "{{pod}}/{{container}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 8,
      "title": "Node CPU / Memory %",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 11},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100", "legendFormat": "cpu %", "refId": "A"},
        {"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "mem %", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 9,
      "title": "PVC Usage %",
      "type": "table",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "100 * kubelet_volume_stats_used_bytes{namespace=\"platform\"} / kubelet_volume_stats_capacity_bytes{namespace=\"platform\"}", "refId": "A", "instant": true}
      ],
      "transformations": [
        {"id": "labelsToFields", "options": {}},
        {"id": "organize", "options": {"renameByName": {"Value": "Used %", "persistentvolumeclaim": "PVC"}}}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
    },
    {
      "id": 10,
      "title": "Node Network (rx/tx bytes/s)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cali.*|flannel.*|cni.*\"}[5m]))", "legendFormat": "rx", "refId": "A"},
        {"expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|cali.*|flannel.*|cni.*\"}[5m]))", "legendFormat": "tx", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 11,
      "title": "Granian Requests / sec",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (rate(granian_requests_handled{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 12,
      "title": "Granian Blocking Queue / Workers",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (service) (granian_blocking_queue{service=~\"$service\"})", "legendFormat": "{{service}} queue", "refId": "A"},
        {"expr": "sum by (service) (granian_blocking_threads{service=~\"$service\"})", "legendFormat": "{{service}} threads", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}}
    }
  ]
}
