model
  schema 1.1

type user

type group
  relations
    define company: [company]
    define member: [user]

type company
  relations
    define owner: [user]
    define admin: [user] or owner
    define member: [user] or admin
    define can_view: member
    define can_edit: admin
    define can_admin: admin

type platform
  relations
    define admin: [user, group#member]

type platform_namespace
  relations
    define company: [company]
    define owner: [user]
    define viewer: [user, company#member] or owner
    define editor: [user, company#member] or owner
    define can_view: viewer or editor
    define can_edit: editor
    define can_admin: owner
    define can_share: can_admin

type crm_namespace
  relations
    define company: [company]
    define viewer: [user, company#member]
    define editor: [user, company#member]
    define can_view: viewer or editor
    define can_edit: editor
    define can_admin: editor
    define can_share: can_admin

type crm_entity
  relations
    define owner: [user]
    define namespace: [crm_namespace]
    define viewer: [user, user:*, company#member] or owner or viewer from namespace
    define editor: [user, company#member] or owner or editor from namespace
    define admin: [user] or owner
    define can_view: viewer or editor or admin
    define can_edit: editor or admin
    define can_admin: admin
    define can_share: can_admin

type wiki_page
  relations
    define owner: [user]
    define parent: [wiki_page]
    define company: [company]
    define viewer: [user] or owner or viewer from parent
    define editor: [user] or owner or editor from parent
    define company_viewer: [company#member]
    define can_view: viewer or editor or company_viewer
    define can_edit: editor
    define can_admin: owner
    define can_share: can_admin

type document_catalog
  relations
    define company: [company]
    define parent: [document_catalog]
    define source: [mailbox_binding, sync_channel, crm_entity, flow, work_queue, wiki_page]
    define owner: [user]
    define lister: [company#member]
    define viewer: [user, company#member] or owner or viewer from parent or can_view from source
    define editor: [user] or owner or editor from parent or can_edit from source
    define can_view: viewer or editor
    define can_list: can_view or lister
    define can_edit: editor
    define can_admin: owner or admin from company
    define can_share: can_admin

type document_file
  relations
    define owner: [user]
    define catalog: [document_catalog]
    define source: [mailbox_binding, sync_channel, crm_entity, flow, work_queue, wiki_page]
    define viewer: [user] or owner or viewer from catalog or can_view from source
    define editor: [user] or owner or editor from catalog or can_edit from source
    define can_view: viewer or editor
    define can_edit: editor
    define can_admin: owner or can_admin from catalog
    define can_share: can_admin

type sync_channel
  relations
    define company: [company]
    define member: [user]
    define admin: [user]
    define owner: [user]
    define can_view: member or admin or owner
    define can_edit: member or admin or owner
    define can_admin: admin or owner

type work_queue
  relations
    define company: [company]
    define owner: [user]
    define member: [user]
    define can_view: owner or member
    define can_edit: owner or member
    define can_admin: owner

type mailbox_binding
  relations
    define company: [company]
    define owner: [user]
    define member: [user]
    define manager: [user]
    define can_view: owner or member or manager or admin from company
    define can_edit: owner or manager or admin from company
    define can_admin: owner or manager or admin from company

type flow
  relations
    define company: [company]
    define platform: [platform]
    define owner: [user]
    define viewer: [user, company#member, group#member]
    define editor: [user, group#member] or owner
    define can_view: viewer or editor or owner or admin from company or admin from platform
    define can_edit: editor or owner or admin from company or admin from platform
    define can_admin: owner or admin from company
    define can_share: can_admin

type flow_branch
  relations
    define flow: [flow]
    define viewer: [user, company#member, group#member] or viewer from flow
    define editor: [user, group#member] or editor from flow
    define can_view: viewer or editor or can_view from flow
    define can_edit: editor or can_edit from flow

type tool
  relations
    define company: [company]
    define platform: [platform]
    define viewer: [user, company#member, group#member]
    define can_view: viewer or admin from platform

type flow_ui_share
  relations
    define flow: [flow]
    define owner: [user]
    define viewer: [user, user:*]
    define editor: [user, user:*]
    define can_view: viewer or editor or owner
    define can_edit: editor or owner

type datasource
  relations
    define company: [company]
    define platform: [platform]
    define owner: [user]
    define viewer: [user, company#member, group#member]
    define editor: [user, group#member] or owner
    define can_view: viewer or editor or owner or admin from platform
    define can_edit: editor or owner or admin from platform
    define can_admin: owner or admin from company

type stock_warehouse
  relations
    define company: [company]
    define owner: [user]
    define viewer: [user, company#member] or owner
    define editor: [user, company#member] or owner
    define can_view: viewer or editor
    define can_edit: editor
    define can_admin: owner
