        },
        "rag": {
            "name": "RAG",
            "menu_description": "Documents and semantic search",
            "description": "Your company knowledge base: upload documents, run semantic search, and give AI answers grounded in your own content"
        },
        "sync": {
            "name": "Sync",
            "menu_description": "Chat, Git, and calls for teams",
            "description": "The engineering team hub: chat, Git, and calls alongside repos — align faster and ship with less friction"
        },
        "worktracker": {
            "name": "Tasks",
            "menu_description": "Inbox, boards, queues, HITL",
