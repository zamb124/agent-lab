        },
        "documents": {
            "name": "Documents",
            "menu_description": "Collaborative Office editing",
            "description": "Collaborative Office editing: binding list, editor in iframe, namespace isolation, secrets only on the BFF"
        },
        "wiki": {
            "name": "Wiki",
            "menu_description": "Company knowledge base: pages, links, search",
            "description": "A knowledge base with a page tree inside each workspace: write documentation, link it to NetWorkle entities and documents, and find it by meaning rather than exact wording"
        },
        "stock": {
            "name": "Stock",
            "menu_description": "Warehouse management: stock, transfers, valuation",
