{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0_9/server_capabilities.json",
  "title": "A2UI Server Capabilities Schema",
  "type": "object",
  "properties": {
    "v0.9": {"$ref": "#/$defs/versionCapabilities"},
    "v0.9.1": {"$ref": "#/$defs/versionCapabilities"}
  },
  "$defs": {
    "versionCapabilities": {
      "type": "object",
      "properties": {
        "supportedCatalogIds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "acceptsInlineCatalogs": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  }
}
