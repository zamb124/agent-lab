# Скопируй в .env рядом с docker-compose.yml (compose.sh делает это сам).
# НЕ коммить .env.

# Абсолютный путь репозитория на хосте (монтируется в контейнер по тому же пути).
REPO_ROOT=/Users/you/power/agent-lab

# MCP HTTP auth (X-API-Key). Сгенерируй: openssl rand -hex 24
MCP_API_KEY=replace-me

# MinIO (только внутри compose-сети, порты наружу не публикуются)
MINIO_ROOT_USER=zedsearch
MINIO_ROOT_PASSWORD=zedsearch-change-me

# Версии npm/CBM при сборке образов — latest (обновляются на `make zed-search-update`).
# При необходимости закрепи: CBM_VERSION=v0.9.0 MCP_PROXY_VERSION=6.5.4
CBM_VERSION=latest
CLAUDE_CONTEXT_MCP_VERSION=latest
MCP_PROXY_VERSION=latest

# Теги pull-образов инфраструктуры (обновляются `docker compose pull` на update)
MILVUS_VERSION=v2.6.7
OLLAMA_IMAGE_TAG=0.9.6
OLLAMA_MODEL=nomic-embed-text

# Ollama embeddings:
# - metal (дефолт на macOS): нативный brew/app Ollama → Apple Metal GPU.
#   Compose НЕ поднимает zed-search-ollama; claude-context → host.docker.internal:11434.
# - docker: контейнер ollama (CPU на Mac, GPU только с NVIDIA runtime на Linux).
OLLAMA_MODE=metal
OLLAMA_HOST=http://host.docker.internal:11434

# Лимиты
CBM_MEM_BUDGET_MB=8192
CBM_WORKERS=4
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=768
HYBRID_MODE=true

# Автоиндексация (один путь на движок — не включать cron поверх sync/watch):
# - claude-context: CLAUDE_CONTEXT_BACKGROUND_SYNC=true (compose/Dockerfile)
# - CBM: CBM_AUTO_INDEX=true + CBM_AUTO_WATCH=true (compose/Dockerfile)
# - reindex-cron: REINDEX_INTERVAL_SEC=0 (idle). >0 только если нужен доп. tick.
# Полный wipe: make zed-search-reindex (force=true).
CBM_AUTO_INDEX=true
CBM_AUTO_WATCH=true
CLAUDE_CONTEXT_BACKGROUND_SYNC=true
CLAUDE_CONTEXT_TRIGGER_WATCHER=true
REINDEX_INTERVAL_SEC=0
REINDEX_FORCE=false
