# syntax=docker/dockerfile:1.7
# CBM linux-бинарь + mcp-proxy.
# Runtime: debian:trixie-slim (CBM нужен GLIBC>=2.38). Node копируется из slim-образа.
# Версии npm/бинаря по умолчанию latest — обновляются при каждой сборке образа.
ARG MCP_PROXY_VERSION=latest
ARG CBM_VERSION=latest
ARG NODE_IMAGE=node:22-bookworm-slim
ARG CBM_RUNTIME_IMAGE=debian:trixie-slim

FROM ${NODE_IMAGE} AS proxy
ARG MCP_PROXY_VERSION
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --omit=dev --no-audit --no-fund "mcp-proxy@${MCP_PROXY_VERSION}" \
 && mcp-proxy --version

# Только скачивание бинаря (не запускаем — бинарь glibc).
FROM alpine:3.21 AS cbm-fetch
ARG TARGETARCH
ARG CBM_VERSION
RUN --mount=type=cache,target=/var/cache/apk \
    apk add --no-cache ca-certificates curl jq
WORKDIR /tmp
RUN set -eu; \
    arch="${TARGETARCH:-}"; \
    if [ -z "$arch" ]; then arch="$(uname -m)"; fi; \
    case "$arch" in amd64|x86_64) a=amd64;; arm64|aarch64) a=arm64;; *) echo "unsupported arch=$arch"; exit 1;; esac; \
    ver="${CBM_VERSION}"; \
    if [ "$ver" = "latest" ]; then \
      ver="$(curl -fsSL https://api.github.com/repos/DeusData/codebase-memory-mcp/releases/latest | jq -r .tag_name)"; \
    fi; \
    mkdir -p /out; \
    echo "CBM_VERSION=$ver arch=$a" > /out/cbm-version.txt; \
    archive="codebase-memory-mcp-linux-${a}.tar.gz"; \
    curl -fsSL -o "$archive" "https://github.com/DeusData/codebase-memory-mcp/releases/download/${ver}/${archive}"; \
    tar xzf "$archive"; \
    install -m 755 codebase-memory-mcp /out/codebase-memory-mcp

FROM alpine:3.21 AS rootfs
COPY --link --from=proxy /usr/local/bin/node /rootfs/usr/local/bin/node
COPY --link --from=proxy /usr/local/lib/node_modules/mcp-proxy /rootfs/usr/local/lib/node_modules/mcp-proxy
COPY --link --chmod=755 --from=cbm-fetch /out/codebase-memory-mcp /rootfs/usr/local/bin/codebase-memory-mcp
COPY --link --from=cbm-fetch /out/cbm-version.txt /rootfs/etc/zed-search-cbm-version.txt
COPY --link --chmod=755 entrypoint-cbm.sh /rootfs/entrypoint-cbm.sh
RUN mkdir -p /rootfs/usr/local/bin \
 && ln -sfn ../lib/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs /rootfs/usr/local/bin/mcp-proxy

FROM ${CBM_RUNTIME_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
COPY --link --from=rootfs /rootfs/ /
ENV CBM_CACHE_DIR=/cache \
    CBM_LOG_LEVEL=info \
    CBM_SQLITE_MMAP_SIZE=0 \
    CBM_MEM_BUDGET_MB=8192 \
    CBM_WORKERS=4 \
    CBM_AUTO_INDEX=true \
    CBM_AUTO_WATCH=false
EXPOSE 9751
ENTRYPOINT ["/entrypoint-cbm.sh"]
