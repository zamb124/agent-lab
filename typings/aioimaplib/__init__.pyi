"""Minimal stubs for aioimaplib used by core.mail.transport."""

class Response:
    result: str
    lines: list[bytes | str]

class IMAP4_SSL:
    def __init__(self, host: str = ..., port: int = ...) -> None: ...
    async def wait_hello_from_server(self) -> None: ...
    async def login(self, user: str, password: str) -> Response: ...
    async def logout(self) -> Response: ...
    async def select(self, mailbox: str = ...) -> Response: ...
    async def uid_search(self, *criteria: str) -> Response: ...
    async def uid(self, command: str, *args: str) -> Response: ...
