{
  "name": "agent-lab",
  "private": true,
  "type": "module",
  "license": "Elastic-2.0",
  "scripts": {
    "build:ui": "node scripts/build/ui.ts",
    "wire:types": "uv run python -m scripts.build.wire_types",
    "build:ui:dev": "node scripts/build/ui.ts --dev",
    "watch:ui": "node scripts/build/ui.ts --dev --watch",
    "typecheck:ui": "tsc -p tsconfig.json",
    "test:core": "npm run test:core-unit && npm run test:core-browser",
    "test:core-browser": "web-test-runner --config web-test-runner.config.ts",
    "test:core-browser:watch": "web-test-runner --config web-test-runner.config.ts --watch",
    "test:core-unit": "vitest run --config vitest.config.ts --coverage",
    "test:core-unit:fast": "vitest run --config vitest.config.ts",
    "test:core-unit:watch": "vitest --config vitest.config.ts",
    "test:ui-components": "web-test-runner --config web-test-runner.config.ts",
    "test:ui-components:watch": "web-test-runner --config web-test-runner.config.ts --watch",
    "test:ui-kit": "web-test-runner --config web-test-runner.config.ts --files tests/ui/design-system/components/**/contract.spec.ts"
  },
  "devDependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "3d-force-graph": "^1.80.1",
    "centrifuge": "^5.8.0",
    "dompurify": "^3.4.17",
    "echarts": "^5.6.0",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "livekit-client": "^2.23.0",
    "marked": "^18.1.2",
    "mermaid": "^11.17.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "@types/leaflet": "^1.9.12",
    "leaflet": "^1.9.4",
    "three": "^0.186.1"
  }
}
