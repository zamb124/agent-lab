{
  "name": "agent-lab",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "build:codemirror": "node scripts/build/bundles/codemirror.mjs",
    "build:marked": "node scripts/build/bundles/marked.mjs",
    "build:centrifuge": "node scripts/build/bundles/centrifuge.mjs",
    "build:prosemirror": "node scripts/build/bundles/prosemirror.mjs",
    "build:ui": "node scripts/build/ui.mjs",
    "build:ui:dev": "node scripts/build/ui.mjs --dev",
    "watch:ui": "node scripts/build/ui.mjs --dev --watch",
    "typecheck:ui": "tsc -p tsconfig.json",
    "test:core": "npm run test:core-unit && npm run test:core-browser",
    "test:core-browser": "web-test-runner --config web-test-runner.config.mjs",
    "test:core-browser:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "test:core-unit": "vitest run --config vitest.config.mjs --coverage",
    "test:core-unit:fast": "vitest run --config vitest.config.mjs",
    "test:core-unit:watch": "vitest --config vitest.config.mjs",
    "test:ui-components": "web-test-runner --config web-test-runner.config.mjs",
    "test:ui-components:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "test:ui-kit": "web-test-runner --config web-test-runner.config.mjs --files tests/ui/design-system/components/**/contract.spec.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@open-wc/testing": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "centrifuge": "^5.8.0",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "marked": "^18.1.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.1"
  }
}
