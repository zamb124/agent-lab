{
  "flow_id": "humanitec_agent",
  "name": "Humanitec agent",
  "description": "Курируемый ассистент HumanitecAgent: поиск, CRM, файлы и браузер через Platform MCP.",
  "tags": ["humanitec", "agent", "assistant"],
  "permission": [],
  "exposed_to_agent": true,
  "entry": "main",
  "nodes": {
    "main": {
      "type": "llm_node",
      "name": "Humanitec agent",
      "prompt": "prompts/main.md",
      "llm": {
        "provider": "humanitec_llm",
        "model": "auto",
        "temperature": 0.2
      },
      "tools": [
        "rag_search",
        "index_search",
        "runet_search",
        "read_file",
        "crm_search_entities",
        "crm_get_entity",
        "browser_duckduckgo_links",
        "browser_page_markdown",
        "ask_user"
      ],
      "output_key": "response"
    }
  },
  "edges": [
    {
      "from_node": "main",
      "to_node": null
    }
  ],
  "variables": {},
  "branches": {}
}
