    "docs": {
      "name": "Documentation Assistant",
      "description": "Lara entry: docs focus with optional pre-lookup; full platform skills attached",
      "tags": [
        "docs",
        "documentation",
        "lara"
      ],
      "permission": [],
      "entry": "docs_lookup",
      "nodes_mode": "merge",
      "nodes": {
        "docs_lookup": {
          "type": "code",
          "name": "Documentation lookup",
          "description": "Optional latency pre-search; docs-knowledge skill remains available for cross-domain.",
          "language": "python",
          "code": "async def run(args, state):\n    content = str(state.get('content') or '').strip()\n    variables = state.get('variables') if isinstance(state.get('variables'), dict) else {}\n    query_parts = [content]\n    for key in ('page_title', 'docs_path', 'page_url'):\n        value = str(variables.get(key) or '').strip()\n        if value:\n            query_parts.append(value)\n    query = '\\n'.join(part for part in query_parts if part).strip() or 'Linnex documentation'\n    language = variables.get('docs_language') or variables.get('interface_language_code') or variables.get('user_language') or 'ru'\n    result = await capability('tools.docs_prepare_context', query=query, limit=5, language=str(language))\n    if not isinstance(result, dict):\n        result = {'success': False, 'error': 'docs_prepare_context returned non-object'}\n    variables['docs_search_context'] = str(result.get('prompt_context') or '')\n    variables['docs_search_links'] = str(result.get('prompt_links') or '')\n    variables['docs_search_status'] = 'found' if result.get('results') else 'not_found'\n    if not result.get('success', False):\n        variables['docs_search_status'] = 'error'\n        variables['docs_search_error'] = str(result.get('error') or 'Documentation search failed')\n    state['variables'] = variables\n    state['docs_search_result'] = result\n    return {'variables': variables, 'docs_search_result': result}\n"
        },
        "main": {
          "name": "Lara Documentation",
          "prompt": "prompts/docs.md",
          "llm": {
            "model": "auto",
            "temperature": 0.2,
            "provider": "linnex_llm"
          },
          "output_key": "response",
          "tools": [
            "ask_user"
          ]
        }
      },
      "edges": [
        {
          "from_node": "docs_lookup",
          "to_node": "main"
        }
      ]
    }
