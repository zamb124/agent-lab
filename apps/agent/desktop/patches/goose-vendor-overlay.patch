+async function fetchHumanitecLlmModelIds(
+  credentials: HumanitecAgentCredentials,
+): Promise<string[]> {
+  const modelsUrl = `${credentials.llm_api_base_url.replace(/\/+$/, '')}/models`;
+  const response = await fetch(modelsUrl, {
+    headers: {
+      Authorization: `Bearer ${credentials.token}`,
+    },
+  });
+  if (!response.ok) {
+    const detail = await response.text();
+    throw new Error(`Humanitec models fetch failed: HTTP ${response.status} ${detail}`);
+  }
+  const body = (await response.json()) as AgentOpenAIModelsResponse;
+  if (!Array.isArray(body.data)) {
+    throw new Error('Humanitec models response missing data');
+  }
+  const modelIds: string[] = [];
+  const seenModelIds = new Set<string>();
+  for (const item of body.data) {
+    if (typeof item?.id !== 'string' || !item.id.trim()) {
+      continue;
+    }
+    const modelId = item.id.trim();
+    if (seenModelIds.has(modelId)) {
+      continue;
+    }
+    seenModelIds.add(modelId);
+    modelIds.push(modelId);
+  }
+  if (modelIds.length === 0) {
+    throw new Error('Humanitec models catalog is empty');
+  }
+  return modelIds;
+}
+
 function notifyExtensionsResync(): void {
   for (const window of BrowserWindow.getAllWindows()) {
     window.webContents.send('humanitec-agent:extensions-resync');
   }
 }
 
+function clearRevokedHumanitecCredentials(userDataPath: string): void {
+  stopHumanitecTunnel();
+  clearHumanitecAgentCredentials(userDataPath);
+  delete process.env.HUMANITEC_PLATFORM_MCP_URL;
+  delete process.env.HUMANITEC_DEVICE_TOKEN;
+}
+
+function startHumanitecCredentialMonitor(
+  credentials: HumanitecAgentCredentials,
+  userDataPath: string,
+): void {
+  const configuredInterval = Number.parseInt(
+    process.env.HUMANITEC_REVOCATION_POLL_INTERVAL_MS ?? '',
+    10,
+  );
+  const intervalMs = Number.isFinite(configuredInterval)
+    ? Math.max(configuredInterval, 250)
+    : 30_000;
+  credentialMonitorTimer = setInterval(() => {
+    if (credentialMonitorRequestInFlight) {
+      return;
+    }
+    credentialMonitorRequestInFlight = true;
+    void fetch(credentials.toolkits_url, {
+      headers: { Authorization: `Bearer ${credentials.token}` },
+    })
+      .then((response) => {
+        if (response.status === 401 || response.status === 403) {
+          clearRevokedHumanitecCredentials(userDataPath);
+        }
+      })
+      .catch((error) => {
+        console.log(`[HumanitecAgent] credential monitor failed: ${String(error)}`);
+      })
+      .finally(() => {
+        credentialMonitorRequestInFlight = false;
+      });
+  }, intervalMs);
+}
