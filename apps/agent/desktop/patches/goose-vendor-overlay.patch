+#[utoipa::path(
+    post,
+    path = "/agent/call_tool",
+    request_body = CallToolRequest,
+    responses(
+        (status = 200, description = "Tool called successfully"),
+        (status = 401, description = "Unauthorized - invalid secret key"),
+        (status = 404, description = "Session not found", body = ErrorResponse),
+        (status = 500, description = "Tool call failed", body = ErrorResponse)
+    )
+)]
+async fn call_tool(
+    State(state): State<Arc<AppState>>,
+    Json(payload): Json<CallToolRequest>,
+) -> Result<Json<CallToolResult>, ErrorResponse> {
+    if std::env::var("GOOSE_ENABLE_DIRECT_TOOL_CALL").as_deref() != Ok("1") {
+        return Err(ErrorResponse::not_found("Route not found"));
+    }
+    let agent = state
+        .get_agent_for_route(payload.session_id.clone())
+        .await
+        .map_err(ErrorResponse::from)?;
+    let session = state
+        .session_manager()
+        .get_session(&payload.session_id, false)
+        .await
+        .map_err(|error| ErrorResponse::not_found(format!("Failed to get session: {error}")))?;
+    let tool_call = CallToolRequestParams::new(payload.name).with_arguments(payload.arguments);
+    let (_, dispatched) = agent
+        .dispatch_tool_call(
+            tool_call,
+            Uuid::new_v4().to_string(),
+            Some(CancellationToken::new()),
+            &session,
+        )
+        .await;
+    let execution = dispatched
+        .map_err(|error| ErrorResponse::internal(format!("Tool dispatch failed: {error:?}")))?;
+    let result = execution
+        .result
+        .await
+        .map_err(|error| ErrorResponse::internal(format!("Tool call failed: {error:?}")))?;
+    Ok(Json(result))
+}
